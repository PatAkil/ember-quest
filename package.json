{
  "name": "ember-quest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ember Quest — a roguelike JRPG built with Retrovibe (TypeScript + Canvas 2D).",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "smoke": "node smoke.mjs",
    "sim": "node sim/run.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "playwright": "1.56.1",
    "esbuild": "^0.25.0"
  }
}
